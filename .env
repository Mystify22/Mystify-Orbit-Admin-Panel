# Mystify Orbit Admin Panel - API Configuration
# Leaving VITE_API_BASE_URL empty uses Vite proxy to prevent CORS errors during development
VITE_API_BASE_URL=
VITE_AVATAR_ENDPOINT=/v1/admin/save-avatar
VITE_COVER_ENDPOINT=/media/upload/cover
VITE_THEME_ENDPOINT=/media/upload/theme
VITE_AUDIO_ENDPOINT=/media/upload/audio
VITE_FILE_FIELD_NAME=file
VITE_AUTH_TOKEN=

# Auth Service API
AUTH_MS_URL=https://auth-ms-r7eg.onrender.com
VITE_SEND_OTP_ENDPOINT=/v1/auth/send-otp
VITE_VERIFY_OTP_ENDPOINT=/v1/auth/verify-otp
